{
  "permissions": {
    "allow": [
      "Bash(target/release/toy check *)",
      "Bash(target/release/toy query *)",
      "Bash(target/release/toy explain *)",
      "Bash(target/release/toy explain)",
      "Bash(target/release/toy api *)",
      "Bash(target/release/toy effects *)",
      "Bash(target/release/toy version *)",
      "Bash(target/release/toy version)",
      "Bash(./target/release/toy check *)",
      "Bash(./target/release/toy query *)",
      "Bash(./target/release/toy explain *)",
      "Bash(./target/release/toy explain)",
      "Bash(./target/release/toy api *)",
      "Bash(./target/release/toy effects *)",
      "Bash(./target/release/toy version *)",
      "Bash(./target/release/toy version)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR/target/release/toy\" ]; then \"$CLAUDE_PROJECT_DIR/target/release/toy\" hook; fi",
            "timeout": 30,
            "statusMessage": "toy check"
          }
        ]
      }
    ]
  }
}
